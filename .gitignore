# Generated configuration (written by `make config`)
config/config.generated.mk

# Build outputs
bin/
lib/
*.a
*.so
*.o
*.o*
src/obj/
app/obj/

# Compiler dependency files (except make.d directories)
*.d
!config/make.d/
!config/make.d/**

# Third-party code downloaded by make config (e.g. Spectra)
/external-libs/

# Data directory (a folder, or a link to e.g. /work; a trailing-slash pattern
# would not match a link, since git sees links as files)
/data

# Logs and batch scripts
*.log
*.out
*.pbs
*.slurm
*.aux
*.bbl
*.blg
*.fls
*.fdb_latexmk

# macOS / editor / agent cruft
.DS_Store
.gdb_history
.swp
.claude/
doxygen/html/
